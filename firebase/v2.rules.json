            ".validate": "newData.hasChildren(['value', 'ts'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 60 && newData.val() <= 86400 && (!data.exists() || newData.val() < data.val())"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "g2048": {
          ".read": "(query.orderByChild === 'value' && ((query.limitToFirst != null && query.limitToFirst <= 50) || (query.limitToLast != null && query.limitToLast <= 50))) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true)",
          ".indexOn": ["value"],
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "(auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && newData.exists() && !root.child('v2').child('moderation').child('bans').child(auth.uid).exists() && (!data.exists() || now - data.child('ts').val() >= 10000)) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists())",
            ".validate": "newData.hasChildren(['value', 'ts'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() % 4 === 0 && newData.val() >= 4 && newData.val() <= 400000 && (!data.exists() || newData.val() > data.val())"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "scoreFlags": {
        ".read": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
        "sudoku-easy": {
          "$uid": {
            ".write": "(auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && newData.exists()) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists())",
            ".validate": "newData.hasChildren(['value', 'ts']) && newData.child('value').val() === newData.parent().parent().parent().child('scores').child('sudoku-easy').child($uid).child('value').val()",
            "value": {
              ".validate": "newData.isNumber()"
            },
