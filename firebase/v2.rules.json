          "$day": {
            ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists()",
            ".validate": "$day.matches(/^20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)",
            "$other": {
              ".validate": false
            },
            "visits": {
              ".write": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            },
            "siteMinutes": {
              ".write": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            },
