{
  "rules": {
    "v2": {
      ".read": false,
      ".write": false,
      "admins": {
        ".read": true,
        "$uid": {
          ".validate": "newData.val() === true"
        }
      },
      "chat": {
        "settings": {
          ".read": true,
          ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "pinned": {
            ".validate": "newData.hasChildren(['text', 'ts'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          ".read": "(query.limitToLast != null && query.limitToLast <= 100) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
          ".indexOn": ["uid"],
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && auth.token.firebase.sign_in_provider === 'google.com' && root.child('v2').child('chat').child('settings').child('enabled').val() !== false && !root.child('v2').child('moderation').child('bans').child(auth.uid).exists() && (!root.child('v2').child('moderation').child('mutes').child(auth.uid).exists() || root.child('v2').child('moderation').child('mutes').child(auth.uid).val() <= now) && newData.parent().parent().child('lastPost').child(auth.uid).val() === now",
            ".validate": "newData.hasChildren(['uid', 'text', 'ts'])",
            "uid": {
              ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && !newData.val().toLowerCase().matches(/(fuck|shit|cunt|bitch|wanker|twat|dickhead|nigg|faggot|retard|whore|slut|pussy)/) && !newData.val().toLowerCase().matches(/(https?:|www\\.|\\.com|\\.co\\.uk)/) && !newData.val().toLowerCase().matches(/[a-z0-9._-]+@[a-z0-9-]+\\.[a-z][a-z]/) && !newData.val().matches(/[0-9]([ .-]?[0-9]){9}/)"
            },
            "ts": {
              ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val())"
            },
            "edited": {
              ".validate": "newData.val() === true && data.parent().exists()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lastPost": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && newData.exists()) || (root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists()))",
            ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 5000)"
          }
        }
      },
      "moderation": {
        ".read": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
        "bans": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === now"
          }
        },
        "mutes": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "presence": {
        ".read": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
        "$uid": {
          "$connection": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === now"
          },
          ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists()"
        }
      },
      "privacyRequests": {
        ".read": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true",
        "$id": {
          ".write": "auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && newData.exists() && (!data.exists() || data.child('status').val() !== 'completed')",
          ".validate": "newData.hasChildren(['uid', 'status', 'createdAt', 'updatedAt'])",
          "uid": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{10,128}$/) && (!data.exists() || newData.val() === data.val())"
          },
          "status": {
            ".validate": "(!data.exists() && newData.val() === 'pending') || (data.val() === 'pending' && (newData.val() === 'processing' || newData.val() === 'completed')) || (data.val() === 'processing' && newData.val() === 'completed')"
          },
          "createdAt": {
            ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val())"
          },
          "updatedAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "scores": {
        "sudoku-easy": {
          ".read": "(query.orderByChild === 'value' && ((query.limitToFirst != null && query.limitToFirst <= 50) || (query.limitToLast != null && query.limitToLast <= 50))) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true)",
          ".indexOn": ["value"],
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "(auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && newData.exists() && !root.child('v2').child('moderation').child('bans').child(auth.uid).exists() && (!data.exists() || now - data.child('ts').val() >= 10000)) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists())",
            ".validate": "newData.hasChildren(['value', 'ts'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 30 && newData.val() <= 86400 && (!data.exists() || newData.val() < data.val())"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "sudoku-medium": {
          ".read": "(query.orderByChild === 'value' && ((query.limitToFirst != null && query.limitToFirst <= 50) || (query.limitToLast != null && query.limitToLast <= 50))) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true)",
          ".indexOn": ["value"],
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "(auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && newData.exists() && !root.child('v2').child('moderation').child('bans').child(auth.uid).exists() && (!data.exists() || now - data.child('ts').val() >= 10000)) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true && !newData.exists())",
            ".validate": "newData.hasChildren(['value', 'ts'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 45 && newData.val() <= 86400 && (!data.exists() || newData.val() < data.val())"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "sudoku-hard": {
          ".read": "(query.orderByChild === 'value' && ((query.limitToFirst != null && query.limitToFirst <= 50) || (query.limitToLast != null && query.limitToLast <= 50))) || (auth != null && root.child('v2').child('admins').child(auth.uid).val() === true)",
          ".indexOn": ["value"],
