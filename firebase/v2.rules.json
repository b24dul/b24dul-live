            ".validate": "newData.hasChildren(['value', 'ts']) && newData.child('value').val() === newData.parent().parent().parent().child('scores').child('g2048').child($uid).child('value').val()",
            "value": {
              ".validate": "newData.isNumber()"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
